{
  "manifest_version": 3,
  "name": "Work-ly: Should I apply?",
  "version": "1.0.0",
  "description": "Reads the job posting you are looking at and opens Work-ly's answer: apply, stretch or skip, checked against your own resume.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/jobs/*",
        "https://*.linkedin.com/comm/jobs/*",
        "https://*.naukri.com/*",
        "https://*.indeed.com/*",
        "https://*.indeed.co.in/*",
        "https://*.instahyre.com/*",
        "https://wellfound.com/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.ashbyhq.com/*",
        "https://*.workday.com/*",
        "https://*.workdayjobs.com/*"
      ],
      "js": ["extract.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    { "resources": ["icons/icon-48.png"], "matches": ["<all_urls>"] }
  ]
}
